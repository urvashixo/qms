# Do not commit real credentials.
# Obtain a fresh Groq key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=gemma2-9b-it

# Required: Supabase Session Pooler URL (Settings > Database > Connect).
# Use the URI host, port 5432/6543 supplied by Supabase, and keep sslmode=require.
# Encode reserved password characters (e.g. @ becomes %40).
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require
